# Backend API base URL (no trailing slash) — used by other modules later
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# Cookie / localStorage key where the access token is stored
NEXT_PUBLIC_AUTH_TOKEN_KEY=hrms_access_token

# App environment label (development | staging | production)
NEXT_PUBLIC_APP_ENV=development

